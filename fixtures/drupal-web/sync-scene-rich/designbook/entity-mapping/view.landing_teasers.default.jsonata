(
  $fields := $;
  [
    {
      "component": "test_integration_drupal:list-view",
      "props": {
        "title": $view.title
      },
      "slots": {
        "rows": [$map($fields.rows, function($id) { { "entity": "node.landing_page", "view_mode": "teaser", "record": $lookup({"1":0,"2":1,"3":2}, $string($id)) } })]
      }
    }
  ]
)
